{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current problem",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run.js",
      "args": ["--debug", "${file}"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
